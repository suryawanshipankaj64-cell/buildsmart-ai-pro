{
  "expo": {
    "name": "BuildSmart AI-Pro Mobile",
    "slug": "buildsmart-aipro-mobile",
    "version": "1.0.0",
    "orientation": "portrait",
    "userInterfaceStyle": "dark",
    "icon": "./assets/icon.png",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.buildsmart.aipro.mobile",
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#FFFFFF"
      },
      "package": "com.buildsmart.aipro.mobile",
      "permissions": [
        "android.permission.CAMERA",
        "android.permission.ACCESS_FINE_LOCATION",
        "android.permission.ACCESS_COARSE_LOCATION",
        "android.permission.READ_EXTERNAL_STORAGE",
        "android.permission.WRITE_EXTERNAL_STORAGE",
        "android.permission.RECORD_AUDIO"
      ]
    },
    "plugins": [
      [
        "expo-camera",
        {
          "cameraPermission": "Allow BuildSmart AI-Pro to capture on-site proof-of-work inspection photos."
        }
      ],
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "Allow BuildSmart AI-Pro to geotag site inspections and telemetry."
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "Allow BuildSmart AI-Pro to access drawings and site inspection photos."
        }
      ],
      [
        "expo-document-picker",
        {}
      ],
      [
        "expo-secure-store"
      ]
    ],
    "extra": {
      "eas": {
        "projectId": "56bcc16d-1349-4e60-a4e6-38af418450cd"
      }
    }
  }
}
